# Blaise Drive MCP — environment variable NAMES only. Never commit real values.
# Copy to .env and fill in. .env is gitignored.

# --- OAuth 2.0 (installed-app / desktop client, refresh-token flow) ---
# Created in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Long-lived refresh token for the Drive account that owns the canonical documents.
# Obtain once via `npm run authorize` (prints a consent URL, exchanges the code).
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Which Drive account this server is bound to ---
# Guards against pointing a certified server at the wrong account. The server verifies the
# token's userinfo email matches this before any write and refuses if it does not.
# Canonical files live under two accounts (CLAUDE.md §4.7):
#   bsmith@blaisesmithproperties.com   blaise@buysellhometeam.com
BLAISE_DRIVE_ACCOUNT_EMAIL=

# --- Optional: archive destination ---
# Drive folder ID that LEGACY snapshots are moved into. If unset, the archive copy stays in
# the source document's parent folder and the maintenance report says so explicitly.
BLAISE_DRIVE_ARCHIVE_FOLDER_ID=

# --- Safety switch ---
# "read-only" (default) refuses every write tool at the dispatch layer regardless of granted
# OAuth scopes. "read-write" is required for any Drive/Docs mutation. Deliberately opt-in, so a
# misconfigured deployment fails closed.
BLAISE_DRIVE_MODE=read-only
